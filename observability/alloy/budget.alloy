// Your series budget (S5, decision 014). Every series from this host passes through one of these three
// before it's sent. Grafana Cloud's free tier allows 10,000 active series for all hosts together
// (contracts/metrics.yaml). With no rules, everything is sent.
//
// Rules are Prometheus relabelling (https://grafana.com/docs/alloy/latest/reference/components/prometheus/prometheus.relabel/):
//   rule { source_labels = ["__name__"]  regex = "node_(cpu|memory)_.*"  action = "keep" }
//   rule { regex = "id"  action = "labeldrop" }

declare "host" {
	argument "forward_to" { }

	prometheus.relabel "rules" {
		forward_to = argument.forward_to.value

		// Decision 014 (B2): drop the node_exporter families no dashboard, SLO or incident uses. Keeps
		// cpu, memory, disk, filesystem, network, pressure and the rest.
		rule {
			source_labels = ["__name__"]
			regex         = "node_(scrape|xfs|netstat|sockstat|timex|softnet|nf|schedstat|cooling)_.*"
			action        = "drop"
		}
	}

	export "receiver" {
		value = prometheus.relabel.rules.receiver
	}
}

declare "containers" {
	argument "forward_to" { }

	prometheus.relabel "rules" {
		forward_to = argument.forward_to.value

		// Decision 014 (B2): container_fs_* was 1,124 of 3,252 series and nothing reads it.
		rule {
			source_labels = ["__name__"]
			regex         = "container_fs_.*"
			action        = "drop"
		}

		// New on every deploy: the container id, the image tag and Compose's container_label_* (config hash,
		// image digest, ...; the rest repeat `name`). `name` stays the same across deploys and keeps series apart.
		rule {
			regex  = "id|image|container_label_.*"
			action = "labeldrop"
		}
	}

	export "receiver" {
		value = prometheus.relabel.rules.receiver
	}
}

declare "services" {
	argument "forward_to" { }

	prometheus.relabel "rules" {
		forward_to = argument.forward_to.value

		// Decision 014 (B2): keep contracts/metrics.yaml's lab_* and Traefik's, and `up`; drop the
		// client libraries' runtime metrics, the scraper's own bookkeeping and prometheus_client's *_created.
		rule {
			source_labels = ["__name__"]
			regex         = "(python|go|process|scrape)_.*|.*_created"
			action        = "drop"
		}
	}

	export "receiver" {
		value = prometheus.relabel.rules.receiver
	}
}
